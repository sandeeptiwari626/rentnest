# =============================================================================
# Production environment for shared hosting
# Domain: https://rent.websprintx.com
#
# 1. Copy this file to .env on the server (public_html/rent/.env)
# 2. Fill in APP_KEY, DB_*, and MAIL_* values
# 3. Assets are built in GitHub Actions and uploaded to public/build
# =============================================================================

APP_NAME=RentNest
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rent.websprintx.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database (MySQL on shared hosting) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# --- Session ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=rent.websprintx.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=rent.websprintx.com

# --- Mail (configure your SMTP provider) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.websprintx.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@websprintx.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Queue / cache (database driver works on shared hosting) ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

VITE_APP_NAME="${APP_NAME}"
